# Evolution API v2 — as mesmas credenciais do next-home.
WHATSAPP_API_URL=https://sua-evolution.exemplo.com
WHATSAPP_API_KEY=
# Nome da instância nesta Evolution. Use um nome que NÃO seja de outro número
# já pareado (ex.: as instâncias "nexthome-<slug>" do next-home).
WHATSAPP_INSTANCIA=whatsapp-web2

# Acesso ao app: quem entra lê o WhatsApp inteiro, então sempre com senha.
APP_SENHA=
# Segredo que assina o cookie de sessão (texto longo e aleatório).
SESSAO_SEGREDO=

# Banco (Supabase) — onde o webhook grava conversas e mensagens.
# A chave é a SECRETA (sb_secret_...) e só roda no servidor. Nunca use
# NEXT_PUBLIC_ nela.
SUPABASE_URL=https://ovzhxczjksqfhvyfjpgh.supabase.co
SUPABASE_SECRET_KEY=

# Webhook: endereço público deste app + segredo que a Evolution manda no
# cabeçalho x-webhook-secret (texto longo e aleatório).
WHATSAPP_WEBHOOK_URL=https://seu-app.vercel.app/api/webhook/evolution
WHATSAPP_WEBHOOK_SECRET=
